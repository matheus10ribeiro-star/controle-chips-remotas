rules_version = '2';
// Regras de segurança do banco (Firestore).
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function admin() { return temPerfil() && perfil().papel == 'admin'; }
    function podeLer() { return temPerfil() && perfil().papel in ['admin', 'leitor']; }

    // Usuários: cada pessoa cria o próprio cadastro como "pendente";
    // só administradores liberam, mudam o acesso ou removem.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin());
      allow create: if logado() && request.auth.uid == uid
                    && request.resource.data.papel == 'pendente';
      allow update: if admin()
                    || (logado() && request.auth.uid == uid
                        && request.resource.data.papel == resource.data.papel);
      allow delete: if admin();
    }

    // Cadastro atual de cada chip
    match /chips/{iccid} {
      allow read: if podeLer();
      allow write: if admin();
    }

    // Histórico de movimentações: ninguém altera nem apaga depois de registrado
    match /movs/{id} {
      allow read: if podeLer();
      allow create: if admin();
      allow update, delete: if false;
    }
  }
}
